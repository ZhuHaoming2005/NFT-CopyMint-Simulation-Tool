{
  "name": "nft-copymint-research",
  "version": "1.0.0",
  "description": "NFT CopyMint Research Project - Support multi-network deployment and three-level CopyMint functionality",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "copymint": "ts-node scripts/copyMint.ts",
    "copymint:sepolia": "ts-node scripts/copyMint.ts --source-chain sepolia --target-chain sepolia",
    "copymint:mainnet": "ts-node scripts/copyMint.ts --source-chain mainnet --target-chain mainnet",
    "node": "hardhat ts-node",
    "verify": "hardhat verify",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:amoy": "hardhat verify --network amoy",
    "verify:base-sepolia": "hardhat verify --network baseSepolia",
    "verify:bsctestnet": "hardhat verify --network bscTestnet",
    "verify:mainnet": "hardhat verify --network mainnet",
    "verify:polygon": "hardhat verify --network polygon",
    "verify:base": "hardhat verify --network base",
    "verify:bsc": "hardhat verify --network bsc"
  },
  "keywords": [
    "NFT",
    "copymints",
    "ERC721",
    "hardhat",
    "solidity",
    "typescript",
    "ipfs"
  ],
  "author": "Haoming Zhu",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^25.0.3",
    "dotenv": "^17.2.3",
    "hardhat": "^2.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "axios": "^1.13.2",
    "bs58": "^6.0.0",
    "ethers": "^6.16.0",
    "form-data": "^4.0.5",
    "pinata": "^2.5.1"
  }
}