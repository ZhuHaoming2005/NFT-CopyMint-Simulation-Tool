{
  "name": "nft-conflict-research",
  "version": "1.0.0",
  "description": "NFT Copymints研究项目 - 支持多测试网部署和测试",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network BaseSepolia",
    "deploy:bsctestnet": "hardhat run scripts/deploy.js --network BSCTestnet",
    "test": "hardhat test",
    "test:mint": "hardhat run scripts/testMint.js",
    "test:mint:sepolia": "hardhat run scripts/testMint.js --network sepolia",
    "test:mint:amoy": "hardhat run scripts/testMint.js --network amoy",
    "test:mint:base-sepolia": "hardhat run scripts/testMint.js --network BaseSepolia",
    "test:mint:bsctestnet": "hardhat run scripts/testMint.js --network BSCTestnet",
    "query:sepolia": "hardhat run scripts/queryNFT.js --network sepolia",
    "query:amoy": "hardhat run scripts/queryNFT.js --network amoy",
    "query:base-sepolia": "hardhat run scripts/queryNFT.js --network BaseSepolia",
    "query:bsctestnet": "hardhat run scripts/queryNFT.js --network BSCTestnet",
    "set-uri:sepolia": "hardhat run scripts/setTokenURI.js --network sepolia",
    "set-uri:amoy": "hardhat run scripts/setTokenURI.js --network amoy",
    "set-uri:base-sepolia": "hardhat run scripts/setTokenURI.js --network BaseSepolia",
    "set-uri:bsctestnet": "hardhat run scripts/setTokenURI.js --network BSCTestnet",
    "compare": "node scripts/compareCopymints.js",
    "node": "hardhat node",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:amoy": "hardhat verify --network amoy",
    "verify:base-sepolia": "hardhat verify --network BaseSepolia",
    "verify:bsctestnet": "hardhat verify --network BSCTestnet"
  },
  "keywords": [
    "NFT",
    "copymints",
    "ERC721",
    "hardhat",
    "solidity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^4.9.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "ethers": "^6.9.0"
  }
}
